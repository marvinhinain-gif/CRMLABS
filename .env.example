# ---------------------------------------------------------------
# CRMLABS — variáveis de ambiente (somente nomes e placeholders)
# Copie para .env e preencha. Nunca faça commit de valores reais.
# ---------------------------------------------------------------

# URL pública da aplicação (HTTPS em produção; usada em links de e-mail e callback OAuth)
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/crmlabs
# Banco usado apenas pelos testes automatizados (será limpo a cada execução)
TEST_DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/crmlabs_test

# Chave de 32 bytes em base64 para criptografar tokens de integração no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# E-mail transacional (convites e recuperação de senha)
# MAIL_TRANSPORT=smtp em produção. "console" só é aceito fora de produção e
# imprime o link no log do servidor (útil para desenvolvimento local).
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="CRMLABS <nao-responda@seudominio.com.br>"

# Primeiro administrador criado por `npm run db:seed`
SEED_ORG_NAME=AXION
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Instagram — API com Login do Instagram (Instagram Login), Meta for Developers
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Token que você define e informa no painel da Meta ao configurar o webhook
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Versão da Graph API conferida na implementação (docs consultadas em 04/10/2026)
INSTAGRAM_GRAPH_VERSION=v25.0
# Só habilite após a Meta aprovar o recurso "Human Agent" para o app
INSTAGRAM_HUMAN_AGENT_ENABLED=false

# Senha dos usuários da organização de DEMONSTRAÇÃO (npm run db:seed:demo).
# Se vazio, uma senha aleatória é gerada e exibida no terminal.
DEMO_PASSWORD=
